{
  "expo": {
    "name": "WTT",
    "slug": "WTT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-game.png",
    "scheme": "wtt",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo-game.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.madaaa.WTT"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-game.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-game.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8305e8b-2279-41ea-bfff-56093e1b4674"
      }
    }
  }
}